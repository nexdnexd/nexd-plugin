{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nexd": {
      "type": "streamable-http",
      "url": "https://api.nexd.com/v3/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "mcp:read"
            ],
            "defaultScopes": [
              "mcp:read",
              "cm:campaign.write",
              "cm:creative.write",
              "cm:publish"
            ]
          }
        }
      }
    }
  }
}